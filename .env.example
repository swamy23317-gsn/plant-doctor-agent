# LLM provider key (required)
# Free tier: get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Model to use in provider/model format (free-tier eligible)
MASTRA_MODEL=google/gemini-3.5-flash-lite

# WhatsApp gateway (no Business API — uses WhatsApp Web multi-device pairing)
WA_SESSION_DIR=.wa-session
WA_ALLOW_GROUPS=false
